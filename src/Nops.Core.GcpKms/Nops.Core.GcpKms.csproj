  <ItemGroup>
    <ProjectReference Include="..\Nops.Core\Nops.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Kms.V1" Version="3.27.0" />
  </ItemGroup>

</Project>
