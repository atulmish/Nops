<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <PackageId>Nops.Core.Azkv</PackageId>
    <Authors>Nops Contributors</Authors>
    <Description>Azure Key Vault master key provider for Nops - in-process SOPS decryption.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nops.Core.Azkv.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nops.Core\Nops.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.10.1" />
  </ItemGroup>

</Project>
