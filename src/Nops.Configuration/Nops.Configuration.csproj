<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <PackageId>Nops.Configuration</PackageId>
    <Authors>Nops Contributors</Authors>
    <Description>Microsoft.Extensions.Configuration provider for SOPS-encrypted files (YAML, JSON, dotenv, INI) with reload on change. Works with ASP.NET Core, the generic host and console apps.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nops.Configuration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nops.Core\Nops.Core.csproj" />
  </ItemGroup>

  <!-- Plain Microsoft.Extensions packages (not the ASP.NET Core shared framework) so the
       provider works in console apps, worker services and Azure Functions too. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
