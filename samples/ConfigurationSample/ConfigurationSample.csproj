<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- In your app: <PackageReference Include="Nops.Configuration" Version="1.0.0" /> -->
    <ProjectReference Include="..\..\src\Nops.Configuration\Nops.Configuration.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="secrets.sops.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
