<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Nops.Templates</PackageId>
    <Authors>Nops Contributors</Authors>
    <Title>Nops project templates</Title>
    <Description>dotnet new templates for a minimal web API and a worker service that load SOPS-encrypted secrets with Nops. Run: dotnet new install Nops.Templates</Description>
    <PackageTags>dotnet-new;templates;sops;secrets;configuration;age</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeSymbols>false</IncludeSymbols>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
